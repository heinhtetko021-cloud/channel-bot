# H-Tech Studio Channel Bot — env template
# Copy to .env for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.
BOT_TOKEN=0000000000:REPLACE_WITH_YOUR_BOT_TOKEN
ADMIN_ID=8390911265
CHANNEL_ID=-1004370717794
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
GROQ_MODEL=openai/gpt-oss-120b
