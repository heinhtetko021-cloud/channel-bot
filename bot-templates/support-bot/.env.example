# H-Tech Support Bot — environment variables
# Copy this file to `.env` (local) and add the same vars to Vercel.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Owner / admin Telegram chat id (for human-escalation notifications)
# Get it from @userinfobot or @RawDataBot, then paste the numeric id.
ADMIN_CHAT_ID=
